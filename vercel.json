{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "outputDirectory": ".next",
  "headers": [
    {
      "source": "/((?!api/(?:tapcard/)?demo/page).*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "crons": [
    { "path": "/api/cron/search-console-snapshot", "schedule": "0 6 * * *" },
    { "path": "/api/cron/biz-trial-reminders", "schedule": "0 8 * * *" },
    { "path": "/api/cron/push-daily", "schedule": "0 16 * * *" },
    { "path": "/api/cron/demo-retention", "schedule": "30 3 * * *" },
    { "path": "/api/cron/stale-cards", "schedule": "45 3 * * *" }
  ]
}
